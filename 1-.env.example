# Copy to `.env` for local development. NEVER commit a real `.env` (it is git-ignored).
# All keys are prefixed VERVANA_. Secrets have no real defaults here.

# --- Operational ---
VERVANA_ENVIRONMENT=development
VERVANA_LOG_LEVEL=INFO
# Timezone is fixed to Asia/Kolkata by policy; do not change.
VERVANA_TIMEZONE=Asia/Kolkata

# --- Datastore ---
# Dev/test default is a local SQLite file. Production uses the Postgres DSN, e.g.:
# VERVANA_DATABASE_URL=postgresql+psycopg://vervana:CHANGEME@localhost:5432/vervana
VERVANA_DATABASE_URL=sqlite:///vervana.dev.sqlite3

# --- Public API (M8) ---
# Comma-separated valid API keys for /api/v1/*, and the per-key rate limit.
VERVANA_PUBLIC_API_KEYS=demo-key
VERVANA_PUBLIC_API_RATE_PER_MIN=60

# Comma-separated connector names to disable (e.g. "youtube,enam").
VERVANA_DISABLED_CONNECTORS=

# --- Agmarknet/data.gov.in network tuning ---
# data.gov.in is often slow (>30s per page). Defaults: 120s timeout, 4 attempts,
# 2s backoff base. Only raise these if captures keep timing out.
VERVANA_AGMARKNET_TIMEOUT_SECONDS=120
VERVANA_AGMARKNET_MAX_RETRIES=4
VERVANA_AGMARKNET_BACKOFF_BASE_SECONDS=2

# --- Secrets (fill in locally; supply via the deploy environment in production) ---
# data.gov.in API key for Agmarknet ingest (needed at M2, not before).
VERVANA_DATA_GOV_IN_API_KEY=

# --- Supply-side feeds (M11) ---
# Sentinel-2 NDVI fallback path: free OAuth client from dataspace.copernicus.eu.
VERVANA_CDS_CLIENT_ID=
VERVANA_CDS_CLIENT_SECRET=
# Endpoint overrides (defaults are the current CDSE values; verify in CDSE docs).
VERVANA_CDS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
VERVANA_CDS_STATISTICS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
# IMD district rainfall: optional machine-readable CSV endpoint (the public
# bulletin is a PDF; without this use `vervana supply rainfall-import <csv>`).
VERVANA_IMD_DISTRICT_RAINFALL_URL=
# Google Agricultural Understanding (ALU/AMED): partner access PENDING. Endpoint
# URLs are not public; set them from the partner docs when access is granted.
# Empty => the scaffold reports "access pending" and fetches nothing.
VERVANA_GOOGLE_AGRI_API_KEY=
VERVANA_GOOGLE_ALU_API_URL=
VERVANA_GOOGLE_AMED_API_URL=
